import pandas as pd

def clean_ridership(filename):
    # Read CSV File
    df = pd.read_csv(filename)
    
    # Calculating the total boarding and alighting using sample size
    df['total_boardings'] = df['boardings'] * df['sample_size']
    df['total_alightings'] = df['alightings'] * df['sample_size']

    # Dropping the average 'boarding' and 'alightings'
    df = df.drop(['boardings', 'alightings'], axis=1)

    # Override results to csv file
    df.to_csv('MBTA_BUS_Ridership_Fall_2022.csv', index=False)

filename = 'MBTA_Bus_Ridership_Fall_2022.csv'
clean_ridership(filename)
